// Prisma schema for StudyBuddy

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============================================
// User Management
// ============================================

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?   @map("password_hash")
  oauthProvider     String?   @map("oauth_provider")
  oauthId           String?   @map("oauth_id")
  name              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  // When the student closed the one-time card that says Margins asks for an attempt before it helps (spec §5).
  seenEffortIntroAt DateTime? @map("seen_effort_intro_at")
  // When the student closed the "About this reading" row above the reader (the Focus and PDF notes), on any device.
  seenReaderNoteAt  DateTime? @map("seen_reader_note_at")
  // A one-way key derived from the Google account (src/lib/account/spend-key.ts) that outlives the account, so the daily
  // allowance and the voice minutes do not reset when the account is deleted and made again. Null until set.
  spendKey          String?   @map("spend_key")

  // Relations
  projects            Project[]
  processingJobs      ProcessingJob[]
  topicProgress       TopicProgress[]
  quizAttempts        QuizAttempt[]
  quizSubmissions     QuizSubmission[]
  overallQuizAttempts OverallQuizAttempt[]
  examSubmissions     ExamSubmission[]
  voiceDrillSessions  VoiceDrillSession[]
  voiceDrillAttempts  VoiceDrillAttempt[]
  learningSignals     LearningSignal[]
  reviewSchedules     ReviewSchedule[]
  practiceProgress    PracticeProgress[]
  chatThreads         ChatThread[]
  llmUsageEvents      LlmUsageEvent[]
  evidenceEvents      EvidenceEvent[]
  conceptMemories     ConceptMemory[]
  recallAttempts      RecallAttempt[]
  marginNotes         MarginNote[]
  tutorStates         TutorState[]
  itemSessions        ItemSession[]
  studyDrafts         StudyDraft[]

  @@index([oauthProvider, oauthId])
  @@index([spendKey])
  @@map("users")
}

// ============================================
// Projects (Study Sessions)
// ============================================

model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  description String?
  status      String   @default("setup") // setup|topics_pending|active|completed
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // The learning plan: the exam date (a calendar date, stored as midnight UTC of that date; null
  // while unknown), the minutes the student can study on a day, and whether the student closed
  // the "When is your exam?" card on the overview.
  examDate            DateTime? @map("exam_date")
  dailyMinutes        Int       @default(45) @map("daily_minutes")
  examPromptDismissed Boolean   @default(false) @map("exam_prompt_dismissed")
  // Set when the student's history was turned into learner-model evidence (lib/learning/backfill.ts, spec §12).
  // Set when every confirmed topic's history is converted (each topic has its own marker, Topic.evidenceBackfilledAt).
  evidenceBackfilledAt DateTime? @map("evidence_backfilled_at")
  // A backfill run's short lease: set when a run starts and honoured until it expires, so two runs do not
  // overlap and a run that died is picked up later. Never a "done" signal.
  evidenceBackfillClaimedAt DateTime? @map("evidence_backfill_claimed_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  materials      Material[]
  topics         Topic[]
  overallQuizzes OverallQuiz[]
  sampleExams    SampleExam[]
  processingJobs ProcessingJob[]
  voiceDrillSessions VoiceDrillSession[]
  learningSignals LearningSignal[]
  reviewSchedules ReviewSchedule[]
  chatThreads    ChatThread[]
  units          Unit[]
  concepts        Concept[]
  conceptEdges    ConceptEdge[]
  evidenceEvents  EvidenceEvent[]
  conceptMemories ConceptMemory[]
  itemSessions    ItemSession[]
  studyDrafts     StudyDraft[]

  @@index([userId])
  @@index([status])
  @@map("projects")
}

// ============================================
// Materials (Uploaded PDFs)
// ============================================

model Material {
  id               String    @id @default(uuid())
  projectId        String    @map("project_id")
  category         String // lecture_notes|sample_exams|book_chapters|syllabus
  filename         String
  gcsPath          String    @map("gcs_path")
  sizeBytes        BigInt    @map("size_bytes")
  validationStatus String    @default("pending") @map("validation_status") // pending|valid|invalid
  validationNotes  String?   @map("validation_notes")
  metadata         Json?
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  validatedAt      DateTime? @map("validated_at")
  // What the file is for: content|syllabus|exam|other. Set at validation (the student's category
  // wins for syllabus and sample_exams, otherwise the validator's "kind") and editable by the
  // student. Syllabus and exam files are never topic sources and are left out of topic mapping
  // and generation retrieval.
  role             String    @default("content")
  // How this past exam is written (question mix, points, task verbs, paraphrased example stems),
  // extracted once the file is chunked and only while role is "exam". Shape: ExamStyleProfile in
  // ai-service/app/services/llm/schemas.py. Null for every other file.
  styleProfile     Json?     @map("style_profile")
  // For a past exam: what each question tests, as {version, input_hash, questions: [{label,
  // summary (a paraphrase of at most 12 words), topic_ids}]}. Written with topics.exam_relevant by
  // ai-service app/services/exam_relevance.py; topic_ids can name topics deleted since. Null otherwise.
  examTopicMap     Json?     @map("exam_topic_map")

  // Relations
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialChunks MaterialChunk[]
  topicSources   TopicSource[]
  conceptClaims  ConceptClaim[]
  marginNotes    MarginNote[]

  @@index([projectId])
  @@index([category])
  @@index([validationStatus])
  @@index([projectId, validationStatus])
  @@map("materials")
}

// ============================================
// Material Chunks (with Embeddings)
// ============================================

model MaterialChunk {
  id                String                 @id @default(uuid())
  materialId        String                 @map("material_id")
  chunkText         String                 @map("chunk_text")
  // 384 numbers from the local embedder (see EMBEDDING_DIMENSIONS in ai-service). The column
  // has an HNSW index (vector_cosine_ops) that Prisma cannot express; it is created in
  // migrations/20261022000000_retrieval_indexes. `prisma migrate dev` will propose dropping
  // "material_chunks_chunk_embedding_hnsw_idx" and the default of search_vector: delete those
  // statements from the migration it generates.
  chunkEmbedding    Unsupported("vector(384)")? @map("chunk_embedding")
  // Generated column: heading path (weight A) and chunk text (weight B), with a GIN index.
  // Written by the database only; also in the same migration.
  searchVector      Unsupported("tsvector")? @map("search_vector")
  sectionHierarchy  String?                @map("section_hierarchy")
  pageStart         Int?                   @map("page_start")
  pageEnd           Int?                   @map("page_end")
  chunkIndex        Int                    @map("chunk_index")
  tokenCount        Int?                   @map("token_count")
  createdAt         DateTime               @default(now()) @map("created_at")

  // Relations
  material             Material              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  topicChunkMappings   TopicChunkMapping[]

  @@index([searchVector], type: Gin, map: "material_chunks_search_vector_idx")
  @@unique([materialId, chunkIndex])
  @@map("material_chunks")
}

// ============================================
// Topics (Extracted Learning Topics)
// ============================================

model Topic {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  name               String
  description        String?
  keywords           String[]
  orderIndex         Int      @map("order_index")
  sourceMaterialIds  String[] @map("source_material_ids")
  userConfirmed      Boolean  @default(false) @map("user_confirmed")
  // Set when this topic's history was converted to evidence (lib/learning/backfill.ts). Until then a topic with
  // concepts keeps the legacy mastery blend (spec §3.6, §12).
  evidenceBackfilledAt DateTime? @map("evidence_backfilled_at")
  createdAt          DateTime @default(now()) @map("created_at")

  // Course structure. unitId is null for topics added by hand and for courses planned before
  // units existed. objectives are verb phrases that finish "By the end you can ...".
  // prerequisiteIds are topics of the same project that come earlier in the course. Both lists
  // have a database default of an empty array (migrations/20261101000000_course_structure) so rows
  // written by raw SQL read as []; `prisma migrate dev` may propose dropping those defaults: keep them.
  unitId             String?  @map("unit_id")
  objectives         String[]
  prerequisiteIds    String[] @map("prerequisite_ids")
  estimatedMinutes   Int?     @map("estimated_minutes")
  // The topic's concepts appear in the student's past exams (set when past exams are read). The
  // learning plan teaches these first when time is short.
  examRelevant       Boolean  @default(false) @map("exam_relevant")

  // Relations
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  sources            TopicSource[]
  topicChunkMappings TopicChunkMapping[]
  content            TopicContent[]
  topicQuizzes       TopicQuiz[]
  progress           TopicProgress[]
  quizAttempts       QuizAttempt[]
  quizSubmissions    QuizSubmission[]
  voiceDrillSessions VoiceDrillSession[]
  voiceDrillSets     VoiceDrillSet[]
  voiceDrillAttempts VoiceDrillAttempt[]
  learningSignals    LearningSignal[]
  reviewSchedules    ReviewSchedule[]
  practiceProgress   PracticeProgress[]
  concepts           Concept[]
  evidenceEvents     EvidenceEvent[]
  conceptMemories    ConceptMemory[]
  recallAttempts     RecallAttempt[]
  marginNotes        MarginNote[]
  studyDrafts        StudyDraft[]

  @@index([projectId, orderIndex])
  @@index([unitId])
  @@map("topics")
}

// ============================================
// Units (a week, a chapter or a lecture group: topics are grouped under them)
// ============================================

model Unit {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  title      String
  summary    String?
  orderIndex Int      @map("order_index")
  // "Week 3" or "Class 11" when the syllabus or calendar says so.
  weekLabel  String?  @map("week_label")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@index([projectId, orderIndex])
  @@map("units")
}

// ============================================
// Topic Sources (the material a topic is taught from)
// ============================================

// One row per planned section: a contiguous range of one file's chunks. A topic is taught
// from its primary rows, in document order. `supporting` is reserved for stored supporting
// spans; today supporting excerpts are found by search at generation time.
model TopicSource {
  id              String  @id @default(uuid())
  topicId         String  @map("topic_id")
  materialId      String  @map("material_id")
  pageStart       Int?    @map("page_start")
  pageEnd         Int?    @map("page_end")
  chunkIndexStart Int     @map("chunk_index_start")
  chunkIndexEnd   Int     @map("chunk_index_end")
  role            String  @default("primary") // primary|supporting

  // Relations
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([materialId])
  @@map("topic_sources")
}

// ============================================
// Topic Chunk Mappings
// ============================================

model TopicChunkMapping {
  id              String   @id @default(uuid())
  topicId         String   @map("topic_id")
  chunkId         String   @map("chunk_id")
  relevanceScore  Float    @map("relevance_score")
  relevanceSource String?  @map("relevance_source") // keyword_match|semantic_search|llm_validated
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  topic Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  chunk MaterialChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([topicId, chunkId])
  @@index([topicId, relevanceScore])
  @@index([chunkId])
  @@map("topic_chunk_mappings")
}

// ============================================
// Topic Content (Generated Study Material)
// ============================================

model TopicContent {
  id          String   @id @default(uuid())
  topicId     String   @map("topic_id")
  contentType String   @map("content_type") // section_notes|solved_examples|interactive_examples|topic_quiz
  contentData Json     @map("content_data") // The actual generated content
  metadata    Json?    // Additional metadata (citations, difficulty, etc.)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, contentType])
  @@map("topic_content")
}

// ============================================
// Topic Quizzes
// ============================================

model TopicQuiz {
  id        String   @id @default(uuid())
  topicId   String   @map("topic_id")
  questions Json
  // standard: written by the AI service. retry: the questions a student missed in their last two
  // attempts, copied from the sets they came from (no model call). warmup: the pretest bank. review_bank:
  // items written for review sessions, only ever appended to; read by review selection, never listed as a quiz.
  kind      String   @default("standard")
  // The job attempt that wrote a standard set: a retry after a crash finds it and adds nothing. A partial unique
  // index (see the ops_locks_deletions migration; Prisma cannot express it).
  sourceJobId String? @map("source_job_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_quizzes")
}

// ============================================
// Topic Progress (User Learning Progress)
// ============================================

model TopicProgress {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  topicId           String    @map("topic_id")
  notesCompleted    Boolean   @default(false) @map("notes_completed")
  notesCompletedAt  DateTime? @map("notes_completed_at") // the first time the notes were marked complete
  examplesCompleted Boolean   @default(false) @map("examples_completed")
  quizCompleted     Boolean   @default(false) @map("quiz_completed")
  quizScore         Float?    @map("quiz_score") // Best score percentage
  lastAccessedAt    DateTime? @map("last_accessed_at")
  // Learning path stages (notesCompleted stays for old data): when the student finished the
  // warm-up, read the topic and did Recall, and when the AI explainer unlocked and why.
  warmupAt              DateTime? @map("warmup_at")
  readAt                DateTime? @map("read_at")
  recallAt              DateTime? @map("recall_at")
  explainerUnlockedAt   DateTime? @map("explainer_unlocked_at")
  explainerUnlockReason String?   @map("explainer_unlock_reason")
  // Tested out of the topic by a strong first quiz, and quick-pass triage (spec 18.8): both count as learned.
  testedOutAt           DateTime? @map("tested_out_at")
  triage                String? // quick
  triageAt              DateTime? @map("triage_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([userId, topicId])
  @@map("topic_progress")
}

// ============================================
// Quiz Attempts (Track multiple quiz attempts)
// ============================================

model QuizAttempt {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  topicId    String   @map("topic_id")
  quizSetId  String?  @map("quiz_set_id")
  answers    Json     // User's answers
  results    Json     // Grading results (correct/incorrect per question)
  score      Float    // Percentage score
  takenAt    DateTime @default(now()) @map("taken_at")
  // When this attempt's concept evidence was written. Null while it is owed: the attempt commits
  // first, and a write that failed is tried again on the student's next visit from `evidencePending`.
  evidenceRecordedAt DateTime? @map("evidence_recorded_at")
  // What the evidence is built from (questions with their answer keys, the answers given, the graded
  // result), kept only until it is written. Never selected into a response.
  evidencePending    Json?     @map("evidence_pending")
  // Failed tries so far and when the last one was: a write is tried again at most once an hour, and
  // given up on after a few tries, so a row that can never be written costs nothing on later visits.
  evidenceAttempts   Int       @default(0) @map("evidence_attempts")
  evidenceTriedAt    DateTime? @map("evidence_tried_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId, takenAt])
  @@index([quizSetId])
  @@index([topicId])
  @@map("quiz_attempts")
}

// A topic quiz submitted while its short answers could not be graded (the AI is unavailable). The
// answers and a copy of the questions are kept, and a grade_quiz job waits for the AI (the exam
// grading mechanism, ai-service job_runner `wait_for_ai`). When the job grades it, `aiGrading` is
// filled and `status` becomes 'graded'; the web app then turns it into the QuizAttempt (same id) and
// applies it to progress, mastery and the review schedule, once (`appliedAt`). Quizzes graded at
// once never get a row here.
model QuizSubmission {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  topicId     String    @map("topic_id")
  quizSetId   String?   @map("quiz_set_id")
  answers     Json
  // The questions (with answer keys) as they were when the student answered. Never sent to the browser.
  questions   Json
  // A hash of the answers, so the same answers to the same set while waiting are one submission (a unique
  // index on pending rows, see the quiz_submissions_dedupe migration; Prisma cannot express it).
  answersHash String?   @map("answers_hash")
  status      String    @default("pending") // pending|graded
  aiGrading   Json?     @map("ai_grading")
  submittedAt DateTime  @default(now()) @map("submitted_at")
  gradedAt    DateTime? @map("graded_at")
  // Set in the same transaction that stores the attempt and its effects: set means applied, in full.
  appliedAt   DateTime? @map("applied_at")
  // When the AI is down, the multiple-choice items the rules can grade are graded at once (spec 18.9): their
  // results and when, while the short answers wait.
  ruleResults Json?     @map("rule_results")
  ruleGradedAt DateTime? @map("rule_graded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId, submittedAt])
  @@index([topicId])
  @@map("quiz_submissions")
}

// ============================================
// Voice Drill Sessions (Conceptual Oral Prep)
// ============================================

model VoiceDrillSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  projectId   String   @map("project_id")
  topicId     String?  @map("topic_id")
  mode        String   @default("topic_drill") // topic_drill|sprint|teach_back
  language    String   @default("en")
  voice       String   @default("marin") // unused since the Claude voice coach (the browser picks the voice)
  style       String   @default("oral_quiz") // oral_quiz|teach_back|guided_reading (older sessions: guided_notes|topic_conversation)
  focus       String?  // optional "what to concentrate on", at most 280 characters
  status      String   @default("active") @map("status") // active|ended|aborted
  interruptCount Int   @default(0) @map("interrupt_count")
  lastDetectedLanguage String? @map("last_detected_language")
  questionSet Json     @map("question_set")
  metrics     Json?
  // The conversation with the coach as Anthropic messages (student and coach text, plus the
  // tool_use / tool_result blocks the model needs), the last ~30. Kept on the server so the
  // browser cannot forge tool results.
  history     Json?
  createdAt   DateTime @default(now()) @map("created_at")
  endedAt     DateTime? @map("ended_at")
  // Set on the first voice turn. Billable time runs from here to endedAt, or to
  // lastSeenAt when the browser went away without ending the session.
  connectedAt DateTime? @map("connected_at")
  lastSeenAt  DateTime? @map("last_seen_at")
  // Question indexes the student asked a hint for (get_hint); an answer after one is assisted (spec §5.8).
  // Database default is an empty array (migrations/20261201000003_voice_hints_backfill_marker): keep it.
  hintedQuestions Int[] @map("hinted_questions")
  // Teach-back and guided reading: where the session is (probes asked per gap, the claim being read). The tools
  // read and write it, so the model cannot move it (spec §5.8).
  coachState Json? @map("coach_state")
  // Set while a voice turn runs (claimed by a conditional update, cleared when it ends); a value older than the
  // longest turn counts as abandoned. Replaces the in-memory double-turn guard.
  turnStartedAt DateTime? @map("turn_started_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic    Topic?             @relation(fields: [topicId], references: [id], onDelete: SetNull)
  attempts VoiceDrillAttempt[]
  timings  VoiceTurnTiming[]

  @@index([userId, projectId])
  @@index([userId, connectedAt])
  @@index([topicId])
  @@map("voice_drill_sessions")
}

// How long one voice turn took (spec §19.10): the server's own numbers, and the browser's for the same turn (sent with the
// next turn). No text of what was said. The P50 and P95 per style come from scripts/voice-timing.ts.
model VoiceTurnTiming {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  userId     String   @map("user_id")
  turn       Int      // the session's turn number (coachState.turn)
  style      String   // oral_quiz|teach_back|guided_reading|topic_conversation
  preRun     String?  @map("pre_run") // the step run before the model spoke (assess|record_answer|reveal|record_check), if any
  graded     Boolean  // a graded step ran this turn, before the model or at its request
  modelCalls Int      @map("model_calls")
  ttftMs     Json     @map("ttft_ms") // per call, milliseconds to the first token (null for a call that had none)
  stepMs     Int      @map("step_ms") // time in graded steps and tools
  firstTextMs Int?    @map("first_text_ms") // request to the first text, on the server
  totalMs    Int      @map("total_ms")
  ok         Boolean
  client     Json? // what the browser measured for this turn (VoiceTurnExtras.timing)
  createdAt  DateTime @default(now()) @map("created_at")

  session VoiceDrillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, turn])
  @@index([createdAt])
  @@map("voice_turn_timings")
}

model VoiceDrillAttempt {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  userId        String   @map("user_id")
  topicId       String?  @map("topic_id")
  questionIndex Int      @map("question_index")
  questionType  String   @map("question_type")
  questionText  String   @map("question_text")
  expectedAnswer Json?   @map("expected_answer")
  userAnswer    String   @map("user_answer")
  isCorrect     Boolean  @map("is_correct")
  score         Float    @default(0)
  feedback      Json?
  timing        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  session VoiceDrillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([sessionId, questionIndex])
  @@index([userId, topicId, createdAt])
  @@index([topicId])
  @@map("voice_drill_attempts")
}

// ============================================
// Learning Signals (Cross-surface performance events)
// ============================================

model LearningSignal {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  topicId    String?  @map("topic_id")
  source     String   // quiz|voice|exam|practice
  score      Float
  confidence Int?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([userId, projectId, topicId])
  @@index([userId, topicId, source, createdAt])
  @@index([source, createdAt])
  @@map("learning_signals")
}

// ============================================
// Practice progress (solved steps per practice problem, so it follows the student across devices)
// ============================================

model PracticeProgress {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  topicId       String    @map("topic_id")
  // The topic's interactive_examples content row the problem belongs to.
  contentId     String    @map("content_id")
  problemIndex  Int       @map("problem_index")
  // The problem's title when the progress was stored: a rewrite with new titles starts clean.
  problemTitle  String    @map("problem_title")
  stepsSolved   Int       @default(0) @map("steps_solved")
  stepsTotal    Int       @map("steps_total")
  hintsUsed     Int       @default(0) @map("hints_used")
  // Step positions (0-based) that were solved, answer-shown or helped by a hint.
  solvedSteps   Int[]     @map("solved_steps")
  revealedSteps Int[]     @map("revealed_steps")
  hintedSteps   Int[]     @map("hinted_steps")
  // Steps with at least one checked answer, and steps whose first check was right (spec §5.6). Both have a
  // database default of an empty array (migrations/20261201000001_practice_rungs): keep it.
  attemptedSteps Int[]    @map("attempted_steps")
  firstTrySteps  Int[]    @map("first_try_steps")
  // Highest help rung used per step (spec §6.2): { "<step index>": rung }. Null on rows from before rungs.
  maxRungs      Json?     @map("max_rungs")
  // Step -> the rung reached at its first wrong check (spec 3.3: a hint after a miss is the failure only).
  missRungs     Json?     @map("miss_rungs")
  // The student's one-line answer to "What tripped you up?", asked after a problem with a wrong check.
  trippedUp     String?   @map("tripped_up")
  // Steps whose evidence is written for the current run through the problem (cleared by "Start over"). A step that
  // finished but is not listed is written by the next save, so a failed write is never lost. The database default
  // is an empty array (migrations/20261202000000_final_review_fixes): keep it.
  evidenceSteps Int[]     @map("evidence_steps")
  // Set when every step is solved or shown; the practice signal is recorded at that moment.
  completedAt   DateTime? @map("completed_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, problemIndex])
  @@index([userId, topicId])
  @@map("practice_progress")
}

// ============================================
// Review Schedules (Spaced review planning)
// ============================================

model ReviewSchedule {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  projectId      String   @map("project_id")
  topicId        String   @map("topic_id")
  mastery        Float    @default(0)
  dueAt          DateTime @map("due_at")
  intervalDays   Int      @default(1) @map("interval_days")
  streak         Int      @default(0)
  lastReviewedAt DateTime? @map("last_reviewed_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId, projectId, dueAt])
  @@map("review_schedules")
}

// ============================================
// Overall Quizzes (Project-wide MCQ)
// ============================================

model OverallQuiz {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  questions Json
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  project  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempts OverallQuizAttempt[]

  @@index([projectId])
  @@map("overall_quizzes")
}

model OverallQuizAttempt {
  id             String   @id @default(uuid())
  overallQuizId  String   @map("overall_quiz_id")
  userId         String   @map("user_id")
  answers        Json
  score          Json
  takenAt        DateTime @default(now()) @map("taken_at")

  // Relations
  overallQuiz OverallQuiz @relation(fields: [overallQuizId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("overall_quiz_attempts")
}

// ============================================
// Sample Exams
// ============================================

model SampleExam {
  id              String   @id @default(uuid())
  projectId       String   @map("project_id")
  name            String
  questions       Json     // Array of questions
  durationMinutes Int      @map("duration_minutes")
  difficultyLevel String   @map("difficulty_level")
  topicsCovered   String[] @map("topics_covered")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submissions ExamSubmission[]

  @@index([projectId])
  @@map("sample_exams")
}

model ExamSubmission {
  id           String    @id @default(uuid())
  sampleExamId String    @map("sample_exam_id")
  userId       String    @map("user_id")
  answers      Json
  aiGrading    Json?     @map("ai_grading")
  aiFeedback   Json?     @map("ai_feedback")
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  gradedAt     DateTime? @map("graded_at")

  // A row is one attempt. It starts as 'in_progress' (the student is taking the exam: the
  // server records startedAt and deadlineAt, and answers are autosaved into `answers`) and
  // becomes 'submitted' when finalised, after which grading fills aiGrading. Rows that
  // existed before attempts are all 'submitted'. A partial unique index (see the
  // exam_attempts migration; Prisma cannot express it) allows one in_progress row per
  // user and exam. While in progress, submittedAt only holds the start time: every reader
  // of results filters on status = 'submitted'.
  status         String    @default("submitted") // in_progress|submitted
  startedAt      DateTime? @map("started_at")
  deadlineAt     DateTime? @map("deadline_at")
  answersSavedAt DateTime? @map("answers_saved_at")

  // Relations
  sampleExam SampleExam @relation(fields: [sampleExamId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When the graded result was first applied to the student's mastery and review schedules (the
  // results page does it the first time it sees the grading). A regrade clears it, so the new
  // grading is applied once more.
  reviewAppliedAt DateTime? @map("review_applied_at")
  // When the graded result's concept evidence was written. Null while it is owed (a graded exam whose
  // write failed is tried again on the next visit); applying a regrade clears it first.
  evidenceRecordedAt DateTime? @map("evidence_recorded_at")
  // Failed tries so far and when the last one was (see QuizAttempt.evidenceAttempts).
  evidenceAttempts   Int       @default(0) @map("evidence_attempts")
  evidenceTriedAt    DateTime? @map("evidence_tried_at")

  @@index([userId])
  @@index([sampleExamId, userId, submittedAt])
  @@map("exam_submissions")
}

// ============================================
// Processing Jobs (Async Job Queue)
// ============================================

model ProcessingJob {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  projectId       String?   @map("project_id")
  jobType         String    @map("job_type")
  status          String    @default("pending") // pending|processing|completed|failed
  stage           String?   @map("stage") // validating|chunking|extracting|generating|grading
  errorCode       String?   @map("error_code")
  retryable       Boolean   @default(true)
  attemptCount    Int       @default(0) @map("attempt_count")
  inputData       Json?     @map("input_data")
  resultData      Json?     @map("result_data")
  progressPercent Int       @default(0) @map("progress_percent")
  errorMessage    String?   @map("error_message")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")

  // The AI service claims a job with an atomic UPDATE and extends leaseUntil while it
  // works. A job still "processing" after leaseUntil has lost its worker.
  maxAttempts     Int       @default(3) @map("max_attempts")
  leaseUntil      DateTime? @map("lease_until")

  // How many times the reaper dispatched this job again because nothing claimed it.
  dispatchCount   Int       @default(0) @map("dispatch_count")

  // What the job acts on, e.g. "extract:<projectId>" or "content:<topicId>:<contentType>".
  // A partial unique index (see the job_reliability migration; Prisma cannot express it)
  // allows one pending/processing job per targetKey.
  targetKey       String?   @map("target_key")

  // Summed over every attempt. llmCostUsd feeds the per-user daily budget.
  llmInputTokens  Int       @default(0) @map("llm_input_tokens")
  llmOutputTokens Int       @default(0) @map("llm_output_tokens")
  llmCostUsd      Decimal   @default(0) @map("llm_cost_usd") @db.Decimal(12, 6)

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([projectId, status])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([status, leaseUntil])
  @@map("processing_jobs")
}

// ============================================
// Ask your materials (chat grounded in a project's materials)
// ============================================

model ChatThread {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId, userId, updatedAt])
  @@index([userId])
  @@map("chat_threads")
}

model ChatMessage {
  id       String @id @default(uuid())
  threadId String @map("thread_id")
  role     String // user|assistant
  content  String
  // Assistant messages only: { sources: [...], marks: [{ offset, marker }] }. The shape is
  // documented in src/lib/chat/citations.ts.
  citations Json?
  // Assistant messages: what Ask tutored on this reply (route, check question card). The shape is
  // documented in src/lib/ask/tutor-message.ts; the card's answer never leaves the server.
  tutor Json?
  // Assistant messages (and billed failure notes). The cost is also written to llm_usage_events,
  // which is what the daily budget sums; these columns are for display and auditing.
  llmInputTokens  Int      @default(0) @map("llm_input_tokens")
  llmOutputTokens Int      @default(0) @map("llm_output_tokens")
  llmCostUsd      Decimal  @default(0) @map("llm_cost_usd") @db.Decimal(12, 6)
  createdAt       DateTime @default(now()) @map("created_at")
  // User messages: the browser's id for this send, so a repeated send never stores the question twice.
  clientRequestId String?  @unique @map("client_request_id")

  // Relations
  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

// ============================================
// LLM usage ledger (the daily budget)
// ============================================

// Append-only: one row per LLM spend (a job attempt, a chat answer, a billed chat failure or a tutor reply),
// written when the cost is known and never deleted by the app. The per-user daily budget sums
// this table, so deleting a thread, a project or its jobs cannot lower it. projectId and sourceId
// are plain columns on purpose: they have no foreign keys, so they outlive what they point at.
//
// Deleting an account does not delete its rows: delete_user_account() unlinks them (userId,
// projectId and sourceId cleared), and a trigger does the same for spend recorded after the
// account is gone, by any writer (both in migration 20261121000000_account_deletion). The global
// daily cap sums every row of the day, so deleting an account cannot lower it.
model LlmUsageEvent {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  projectId    String?  @map("project_id")
  source       String // job|chat|voice|tutor|recall
  sourceId     String   @map("source_id") // processing job id, chat message id or voice session id
  models       String   @default("") // comma-separated
  inputTokens  Int      @default(0) @map("input_tokens") // cache reads and writes included
  outputTokens Int      @default(0) @map("output_tokens")
  // The part of inputTokens read from, and written to, the prompt cache (A4: what caching saves, per source).
  cacheReadTokens  Int      @default(0) @map("cache_read_tokens")
  cacheWriteTokens Int      @default(0) @map("cache_write_tokens")
  costUsd      Decimal  @default(0) @map("cost_usd") @db.Decimal(12, 6)
  // The account's spend_key, stamped by the insert trigger (users, else deleted_accounts); the daily allowance sums by it.
  spendKey     String?  @map("spend_key")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([spendKey, createdAt])
  @@index([createdAt])
  @@map("llm_usage_events")
}

// Whether the AI provider can be used right now, for every user at once. One row, id "global",
// written by the AI service (raw SQL, like every other table it touches): a provider-level failure
// (out of credit, rejected key, no key, or repeated overload past the SDK's own retries) sets it
// to "unavailable" with the error code as `reason`; any successful model call sets it back to
// "available". `since` is when the current state began, `checkedAt` when a call last confirmed
// it. An "unavailable" row older than AI_STATUS_TTL_S counts as unknown, so the next real call
// tests the provider again (there is no paid probe). The web app reads it through the AI
// service's GET /status/ai.
model AiStatus {
  id        String    @id @default("global")
  state     String    @default("available") // available|unavailable
  reason    String? // the LLM error code that set "unavailable"
  since     DateTime?
  checkedAt DateTime  @default(now()) @map("checked_at")
  // The provider's own words, for logs and the owner alert. Never shown to students.
  detail    String?

  @@map("ai_status")
}

// ============================================
// Learner model (learning v3): concepts, evidence, memory
// ============================================

// One idea a topic teaches, found by the concept extraction job. Merged and removed concepts stay
// as rows (status) so evidence that names them keeps its meaning.
model Concept {
  id               String   @id @default(uuid())
  projectId        String   @map("project_id")
  topicId          String   @map("topic_id")
  name             String // 2-6 words
  summary          String // one sentence stating the idea
  kind             String // fact|concept|procedure|judgment
  orderIndex       Int      @map("order_index")
  // Has a database default of an empty array (migrations/20261201000000_learning_v3) so rows
  // written by raw SQL read as []; `prisma migrate dev` may propose dropping that default (and
  // the one on tutor_states.concept_ids, topic_ids on item_sessions): keep them.
  objectiveIndexes Int[]    @map("objective_indexes")
  difficultyPrior  Float    @default(0) @map("difficulty_prior")
  status           String   @default("active") // active|merged|removed
  mergedIntoId     String?  @map("merged_into_id")
  origin           String   @default("llm") // llm|student
  // 384 numbers from the local embedder, as on material_chunks.chunk_embedding.
  embedding        Unsupported("vector(384)")?
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic      Topic           @relation(fields: [topicId], references: [id], onDelete: Cascade)
  mergedInto Concept?        @relation("ConceptMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom Concept[]       @relation("ConceptMerge")
  claims     ConceptClaim[]
  outgoing   ConceptEdge[]   @relation("EdgeSource")
  incoming   ConceptEdge[]   @relation("EdgeTarget")
  evidence   EvidenceEvent[]
  memories   ConceptMemory[]

  @@index([projectId, topicId, orderIndex])
  @@index([topicId])
  @@map("concepts")
}

// What the course material says about a concept, with a quote that was checked against the chunk.
model ConceptClaim {
  id         String  @id @default(uuid())
  conceptId  String  @map("concept_id")
  text       String
  quote      String // at most 300 characters, a whitespace-normalised substring of the chunk
  materialId String  @map("material_id")
  // Not a foreign key: chunks are rewritten when a file is processed again.
  chunkId    String? @map("chunk_id")
  pageStart  Int?    @map("page_start")
  pageEnd    Int?    @map("page_end")
  orderIndex Int     @map("order_index")

  // Relations
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([conceptId])
  @@index([materialId])
  @@map("concept_claims")
}

model ConceptEdge {
  id            String   @id @default(uuid())
  projectId     String   @map("project_id")
  sourceId      String   @map("source_id")
  targetId      String   @map("target_id")
  type          String // prerequisite|encompasses|confusable
  // One of 0.25, 0.5, 0.75, 1. Used for encompasses; 1 otherwise.
  weight        Float
  confidence    Float
  origin        String   @default("llm") // llm|student
  status        String   @default("proposed") // proposed|confirmed|rejected
  evidenceQuote String?  @map("evidence_quote")
  createdAt     DateTime @default(now()) @map("created_at")

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source  Concept @relation("EdgeSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target  Concept @relation("EdgeTarget", fields: [targetId], references: [id], onDelete: Cascade)

  // For a confusable edge, the smaller id is the source.
  @@unique([sourceId, targetId, type])
  @@index([projectId])
  @@index([targetId])
  @@map("concept_edges")
}

// Append-only: one row per graded answer for one concept. ConceptMemory is rebuilt from these.
model EvidenceEvent {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  projectId  String   @map("project_id")
  topicId    String?  @map("topic_id")
  conceptId  String   @map("concept_id")
  itemKey    String   @map("item_key")
  // warmup|recall|quiz|review|exam|practice|example|voice|teach_back|ask_check|reader|drill|implicit|instruction
  source     String
  score      Float // 0 to 1
  assistance Int
  confidence Float? // 0 to 1
  // The role weight times the grader weight.
  weight     Float
  role       String // primary|secondary
  gradedBy   String   @map("graded_by") // rule|model|self
  latencyMs  Int?     @map("latency_ms")
  sessionKey String   @map("session_key")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([userId, conceptId, createdAt])
  @@index([userId, projectId, createdAt])
  @@index([userId, sessionKey])
  @@index([userId, itemKey])
  @@index([conceptId])
  @@index([projectId])
  @@index([topicId])
  @@map("evidence_events")
}

// What one student knows about one concept. A cache: replayConcept rebuilds the whole row from
// EvidenceEvent.
model ConceptMemory {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  projectId        String    @map("project_id")
  topicId          String    @map("topic_id")
  conceptId        String    @map("concept_id")
  // FSRS state (the ts-fsrs card).
  card             Json?
  dueAt            DateTime? @map("due_at")
  stability        Float?
  lastReviewAt     DateTime? @map("last_review_at")
  nUnassisted      Int       @default(0) @map("n_unassisted")
  nAssisted        Int       @default(0) @map("n_assisted")
  lastEvidenceAt   DateTime? @map("last_evidence_at")
  lastAssistedAt   DateTime? @map("last_assisted_at")
  // The warm-up score, and the misconception the last misses pointed at.
  inferredPrior    Float?    @map("inferred_prior")
  misconception    String?
  misconceptionAt  DateTime? @map("misconception_at")
  consecutiveFails Int       @default(0) @map("consecutive_fails")
  mastery          Float     @default(0)
  // not_started|inferred|shaky|getting_there|solid|fading
  label            String    @default("not_started")
  // Replay-derived inputs the selectors read: firstEvidenceDay, itemKeysSeen, delayedNewSuccess,
  // modeReached, lastMaxRung, lastMissKind.
  derived          Json      @default("{}")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId, projectId, dueAt])
  @@index([topicId])
  @@index([conceptId])
  @@index([projectId])
  @@map("concept_memories")
}

model RecallAttempt {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  topicId        String   @map("topic_id")
  kind           String // recall|teach_back
  promptText     String   @map("prompt_text")
  objectiveIndex Int?     @map("objective_index")
  answerText     String   @map("answer_text")
  mode           String // text|voice
  result         Json
  explainer      Json?
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, topicId, createdAt])
  @@index([topicId])
  @@map("recall_attempts")
}

// A note or a question the student attached to a passage while reading.
model MarginNote {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  topicId    String   @map("topic_id")
  materialId String   @map("material_id")
  // Not a foreign key: chunks are rewritten when a file is processed again.
  chunkId    String   @map("chunk_id")
  kind       String // note|question|answer (a reader check answer, with reply.parentNoteId)
  text       String
  reply      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic    Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([userId, topicId, createdAt])
  @@index([materialId])
  @@map("margin_notes")
}

// Where one tutoring conversation stands on the hint ladder. Ask threads use scope "ask" and the
// thread id as scopeKey.
model TutorState {
  id                 String   @id @default(uuid())
  userId             String   @map("user_id")
  scope              String // practice|ask|voice|reader
  scopeKey           String   @map("scope_key")
  rung               Int      @default(0)
  attempts           Int      @default(0)
  lowEffortTurns     Int      @default(0) @map("low_effort_turns")
  revealed           Boolean  @default(false)
  conceptIds         String[] @map("concept_ids")
  // The highest rung reached and the authored hints opened (it only rises), the guesses in a row
  // with no reasoning, and the replies at one rung without progress (spec 6.2), and the gap
  // the last reply addressed.
  maxRung            Int      @default(0) @map("max_rung")
  hintsOpened        Int      @default(0) @map("hints_opened")
  bareGuesses        Int      @default(0) @map("bare_guesses")
  sameRungNoProgress Int      @default(0) @map("same_rung_no_progress")
  gapId              String?  @map("gap_id")
  // Checked answers the server saw on this step: all, wrong, whether the last was wrong, and whether
  // the right answer was given (spec 6.2: the reply may then confirm it).
  checks             Int      @default(0)
  wrongChecks        Int      @default(0) @map("wrong_checks")
  lastCheckWrong     Boolean  @default(false) @map("last_check_wrong")
  checkedCorrect     Boolean  @default(false) @map("checked_correct")
  // Practice evidence reads these (the browser's word is not evidence): the highest rung of help the student was
  // actually given (an opened hint, a tutor reply's rung, the worked example), which `maxRung` does not say because
  // it also climbs with every wrong check; and the help level at the step's first wrong check (null before one).
  helpRung           Int      @default(0) @map("help_rung")
  firstMissRung      Int?     @map("first_miss_rung")
  // The answer the server graded as right (the latest one), so a reply may confirm that and nothing the browser sends.
  checkedAnswer      String?  @map("checked_answer")
  // Ask `understand` turns with no attempt from the student, the concepts they covered, the replies in a row the
  // student could not parse, and when they last said "I don't know" (spec 18.3, 6.3, 5.2).
  understandNoAttempt Int      @default(0) @map("understand_no_attempt")
  understandConcepts  String[] @map("understand_concepts")
  cantParseTurns      Int      @default(0) @map("cant_parse_turns")
  dontKnowAt          DateTime? @map("dont_know_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope, scopeKey])
  @@map("tutor_states")
}

// A warm-up, review session or concept drill, with the items as served so a later regeneration
// cannot change what was graded. Never stored as a QuizAttempt. `results.meta` may carry short, abandoned and
// retestCap (spec 18.8).
model ItemSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  projectId   String    @map("project_id")
  kind        String // warmup|review|drill
  topicIds    String[]  @map("topic_ids")
  items       Json
  answers     Json?
  results     Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId, createdAt])
  @@index([projectId])
  @@map("item_sessions")
}

// What a student is typing or has answered so far on a surface, kept on the server so a closed tab, a reload
// or another device loses nothing (spec 18.7). One row per user, surface and scope; the payload is at most 16 KB.
model StudyDraft {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String   @map("project_id")
  topicId   String?  @map("topic_id")
  surface   String // quiz|recall|reader_check|explainer_check|review|practice|ask|worked_example
  scopeKey  String   @map("scope_key")
  payload   Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, surface, scopeKey])
  @@index([userId, expiresAt])
  @@index([projectId])
  @@index([topicId])
  @@map("study_drafts")
}

// ============================================
// Operations: what the watchdog reads (docs/deployment/RAILWAY.md, "Alerts")
// ============================================

// Facts the operator's checks need, one row each: when the nightly backup last succeeded, when the
// watchdog and the voice purge last ran, which embedding model wrote the stored vectors.
model OpsState {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("ops_state")
}

// A failure that was handled and logged where it happened (a ledger write, a storage delete, a
// dispatch). The watchdog counts them by kind; rows older than 30 days are deleted by it.
model OpsEvent {
  id        BigInt   @id @default(autoincrement())
  kind      String
  source    String // "ai" or "web"
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([kind, createdAt])
  @@index([createdAt])
  @@map("ops_events")
}

// When the watchdog last sent each kind of alert, so every process sends it once per cooldown.
model OpsAlert {
  kind        String   @id
  lastSentAt  DateTime @map("last_sent_at")
  lastMessage String   @map("last_message")

  @@map("ops_alerts")
}

// ============================================
// Spend keys (the allowance and voice minutes that survive account deletion)
// ============================================

// When each spend_key was first seen. Never deleted; the account's age (first-day allowance, the share of the global
// cap kept for older accounts) is read from it. Written by the web app when an account is created.
model SpendAccount {
  spendKey    String   @id @map("spend_key")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  @@map("spend_accounts")
}

// The tombstone delete_user_account() writes (migration 20261208000000_spend_key_and_drill_sets), so a ledger row for
// an account that is already gone is still stamped with its key. No foreign key: the account is gone.
model DeletedAccount {
  userId    String   @id @map("user_id")
  spendKey  String?  @map("spend_key")
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@map("deleted_accounts")
}

// Seconds of voice time each session used, by spend_key, kept by a trigger on voice_drill_sessions. No foreign key to
// the session or the user: deleting a course or the account does not give the minutes back.
model VoiceUsage {
  sessionId   String   @id @map("session_id")
  spendKey    String?  @map("spend_key")
  connectedAt DateTime @map("connected_at")
  seconds     Int      @default(0)
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@index([spendKey, connectedAt])
  @@map("voice_usage")
}

// A generated drill set per topic, kept so asking again for the same inputs costs nothing. `inputsHash` covers what
// changes the output (the notes, count, difficulty, the topic's concepts and the prompt version). General on purpose:
// it names no voice session.
model VoiceDrillSet {
  id         String   @id @default(uuid())
  topicId    String   @map("topic_id")
  inputsHash String   @map("inputs_hash")
  count      Int
  questions  Json
  createdAt  DateTime @default(now()) @map("created_at")

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, inputsHash])
  @@map("voice_drill_sets")
}

// Files whose row was deleted (a material, a project, a failed upload), queued in the same transaction as the delete.
// The AI service's reaper loop deletes them from storage and retries with backoff; the watchdog alerts when one is
// stuck.
model PendingFileDeletion {
  id            String    @id @default(dbgenerated("gen_random_uuid()::text"))
  path          String
  reason        String
  createdAt     DateTime  @default(now()) @map("created_at")
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  doneAt        DateTime? @map("done_at")

  @@index([doneAt, lastAttemptAt])
  @@map("pending_file_deletions")
}

// Fixed-window request counters shared by every web instance (migration 20261208000003_rate_limits). The key is
// "<limiter name>:<spend key>", or "<limiter name>:ip:<address>" for a visitor with no account. Pruned by the limiter.
model RateLimitHit {
  key         String
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
  @@map("rate_limit_hits")
}
