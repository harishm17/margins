# Database
DATABASE_URL="postgresql://dev:devpass@localhost:5432/margins"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# Material storage. With S3_BUCKET set, uploads go to an S3-compatible bucket (Railway Buckets,
# S3, R2, MinIO). Otherwise they go to the local folder LOCAL_UPLOADS_DIR (default /data/uploads,
# or /tmp/margins-uploads when that is not writable). The AI service reads the same two folders.
# S3_BUCKET=""
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"   # true for MinIO and other path-style stores
# LOCAL_UPLOADS_DIR="/data/uploads"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
AI_INTERNAL_TOKEN="replace-with-shared-secret"

# Largest study file a student can upload, in MB (default 25). Larger files get 413 before the body is read.
MAX_UPLOAD_MB="25"

# Voice coach: minutes of voice time each user may use in any 24 hours (default 30)
VOICE_DAILY_MINUTES="30"

# App mode used by runtime deployment checks
ENVIRONMENT="development"  # set to production on deployed environments
