# Database
DATABASE_URL="postgresql://dev:devpass@localhost:5432/margins"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Keys the one-way account key behind the daily allowance and voice minutes. Required in production; set once and never
# rotate it. Development and tests use a fixed value when it is empty.
SPEND_KEY_SECRET=""

# Google sign-in, the only way students sign in. Production will not start without a real OAuth client.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Local only: a test sign-in on /login for any @example.com address, with no password (e2e, screenshots,
# local development without Google). The web app refuses to start with it unless NEXTAUTH_URL is on localhost.
# ENABLE_TEST_LOGIN="true"

# Material storage. With S3_BUCKET set, uploads go to an S3-compatible bucket (Railway Buckets,
# S3, R2, MinIO). Otherwise they go to the local folder LOCAL_UPLOADS_DIR (default /data/uploads,
# or /tmp/margins-uploads when that is not writable). The AI service reads the same two folders.
# S3_BUCKET=""
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"   # true for MinIO and other path-style stores
# LOCAL_UPLOADS_DIR="/data/uploads"

# AI Service
AI_SERVICE_URL="http://localhost:8000"
AI_INTERNAL_TOKEN="replace-with-shared-secret"

# Largest study file a student can upload, in MB (default 25). Larger files get 413 before the body is read.
MAX_UPLOAD_MB="25" # per file; values above 50 are capped at 50

# Voice coach: minutes of voice time each user may use in any 24 hours (default 30)
VOICE_DAILY_MINUTES="30"

# Voice coach: "true" answers a graded teach-back turn with a reply the app builds, with no coach-model call for that turn
# (docs/design/DECISIONS.md, "Redesign step 1"). Off by default.
VOICE_GRADER_LED="false"

# App mode used by runtime deployment checks
ENVIRONMENT="development"  # required: development, test or production (production on deployed environments)
