# Settings for `docker compose up` (docker-compose.yml reads this file as .env).
# Copy it to .env. Running without Docker? Each service has its own example instead:
# frontend/.env.example and ai-service/.env.example.
# Compose sets DATABASE_URL, AI_SERVICE_URL and the uploads folder itself.

# ============================================
# Web app
# ============================================

# NextAuth. The README quickstart appends a random NEXTAUTH_SECRET and AI_INTERNAL_TOKEN to .env;
# without them compose falls back to fixed development values.
# NEXTAUTH_SECRET=""              # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_OAUTH_CLIENT_ID="your-google-client-id"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-client-secret"

# Shared secret between the web app and the AI service (same value in both)
# AI_INTERNAL_TOKEN=""            # openssl rand -hex 32

# Largest study file a student can upload, in MB, and voice minutes per user per 24 hours
MAX_UPLOAD_MB="25"
VOICE_DAILY_MINUTES="30"

# ============================================
# AI service
# ============================================

# "mock" returns schema-valid placeholder output with no API calls and no key, so the whole app
# runs for free. For real notes, quizzes and grading set "anthropic" and an API key.
LLM_PROVIDER="mock"  # mock or anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_FAST_MODEL="claude-haiku-5-5"

# Embeddings: "local" runs BAAI/bge-small-en-v1.5 in-process (no key). "openai" needs
# OPENAI_API_KEY and a migration first (see README, "Migrations and re-embedding").
EMBEDDING_PROVIDER="local"
OPENAI_API_KEY=""

# Processing
ENABLE_PROCESSING=true  # false skips reading files (validation and chunking are simulated)
AUTO_EXTRACT_TOPICS_ON_CHUNK=false  # keep false for the user-driven topic extraction flow
UVICORN_WORKERS=2

# development or production (production turns on the deployment checks)
ENVIRONMENT="development"

# Model per purpose, budgets, chat and planner limits: see ai-service/.env.example. Compose
# passes only the settings above to the AI service.
