# Database
DATABASE_URL="postgresql://dev:devpass@localhost:5432/margins"

# LLM (Claude generates and grades everything)
# "mock" returns schema-valid placeholder output with no API calls (local runs, e2e).
LLM_PROVIDER="anthropic"  # anthropic or mock
ANTHROPIC_API_KEY="your-anthropic-api-key"
# The two fallback models. A purpose below with no value of its own uses the main model (notes,
# examples, practice, quizzes, exams, chat) or the fast one (grading, topics, voice, validation).
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_FAST_MODEL="claude-haiku-5-5"
ANTHROPIC_EFFORT="medium"
ANTHROPIC_FAST_EFFORT="low"
# One model per purpose, "<model-id>:<effort>" (":low" keeps the fallback model, "<model-id>" keeps
# the fallback effort). Empty = the fallback above, which is today's behaviour.
# MODEL_NOTES=""
# MODEL_EXAMPLES=""
# MODEL_PRACTICE=""
# MODEL_QUIZ=""
# MODEL_EXAM=""
# MODEL_GRADING=""
# MODEL_TOPICS="claude-opus-5-5:low"  # the one course-planning call per course (default)
MODEL_CHAT=":low"
MODEL_VOICE=":low"
# MODEL_VALIDATION=""
LLM_TIMEOUT_SECONDS=180
# Retries the SDK makes itself (429, 5xx, connection errors; honours retry-after) before a job
# fails as transient and the dispatcher retries it
LLM_MAX_RETRIES=4
# Model calls running at once in the AI service (jobs for one topic also run one at a time)
LLM_MAX_CONCURRENCY=4

# Embeddings
# "local" runs BAAI/bge-small-en-v1.5 in-process (384 dims, no key).
# "openai" uses text-embedding-3-small (1536 dims, needs OPENAI_API_KEY) but the chunk column is
# vector(384): it needs a new migration first (see README, "Upgrading chunks").
# After changing the model (or upgrading from 1536-dim vectors), re-embed existing chunks from ai-service/:
#   uv run python scripts/reembed_chunks.py
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
# EMBEDDING_CACHE_DIR=""  # the Docker image bakes the model into /opt/models

# OpenAI (optional): only the "openai" embedding provider.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Processing
ENABLE_PROCESSING=true
AUTO_EXTRACT_TOPICS_ON_CHUNK=false

# Jobs
# Seconds between sweeps for jobs whose worker died (0 = off; POST /jobs/reap still works)
JOB_REAPER_INTERVAL_SECONDS=60
# Jobs never claimed after this many seconds are dispatched again (then at 2x, 3x...), and
# failed with JOB_DISPATCH_FAILED after JOB_MAX_REDISPATCHES re-dispatches
JOB_PENDING_REDISPATCH_SECONDS=120
JOB_MAX_REDISPATCHES=3
# Most one user's LLM jobs and chat answers may cost per UTC day (0 = no cap)
DAILY_LLM_BUDGET_USD=8.00
# Most ALL users together may cost per UTC day (0 = no cap): the ceiling on the shared API key's bill
GLOBAL_DAILY_LLM_BUDGET_USD=40.00
# Shared AI status: an outage on record expires after this many seconds, so the next real call
# tests the provider again; overloads in a row that count as an outage
AI_STATUS_TTL_S=300
AI_STATUS_TRANSIENT_THRESHOLD=3
# Optional: a Discord, Slack or ntfy webhook told once when the AI becomes unavailable
OPS_ALERT_WEBHOOK_URL=

# Course structure
# Tokens of a topic's own source sections given to the model, and supporting chunks from other files
TOPIC_SOURCE_TOKEN_BUDGET=16000
TOPIC_SUPPORTING_CHUNKS=4
# A course outline bigger than this (tokens, or sections) is planned per group of files
PLANNER_MAX_OUTLINE_TOKENS=120000
PLANNER_MAX_SECTIONS_PER_CALL=400
PLANNER_MAX_SOURCE_TOKENS_PER_CALL=150000
PLANNER_SYLLABUS_TOKENS=6000

# Ask your materials (chat)
CHAT_MAX_TOKENS=4000
CHAT_TOP_K=12
CHAT_MIN_SIMILARITY=0.5  # chunks below this cosine similarity are not offered to the model
# Database pool
DB_POOL_MAX_SIZE=20
DB_COMMAND_TIMEOUT_SECONDS=60

# Dispatch: with ENABLE_CLOUD_TASKS=true follow-up jobs go through Cloud Tasks
# (project falls back to GCS_PROJECT_ID); otherwise this service posts to AI_SERVICE_URL itself
ENABLE_CLOUD_TASKS=false
# CLOUD_TASKS_PROJECT_ID=""
# CLOUD_TASKS_LOCATION="us-central1"
# CLOUD_TASKS_QUEUE="margins-jobs"

# S3-compatible bucket, for materials the frontend stored as s3://bucket/key
# S3_ENDPOINT=""
# S3_REGION="auto"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE=false

# GCP
GCS_BUCKET="margins-materials"
GCS_PROJECT_ID="your-gcp-project-id"

# Service Configuration
AI_SERVICE_URL="http://localhost:8000"
FRONTEND_URL="http://localhost:3000"
ENVIRONMENT="development"
AI_INTERNAL_TOKEN="replace-with-shared-secret"
PORT="8000"
