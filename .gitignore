# Environment variables
.env
.env.local
.env*.local

# Dependencies
node_modules/
venv/
__pycache__/
*.pyc

# Build outputs
.next/
dist/
build/

# Database
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Testing
.coverage
htmlcov/
.pytest_cache/

# Documentation (ignore .md files except README.md and docs/)
*.md
!README.md
!docs/**/*.md

# Misc
*.pem
.vercel

.claude

# Retrieval eval downloads (OpenStax PDFs are not committed)
evals/.cache/
!evals/results/*.md

# e2e stack logs and uploads (scripts/e2e-stack.sh)
.e2e/

# Generation eval: source excerpts and model outputs (derived from CC BY-NC-SA course material) stay local
evals/results/*/raw/
evals/results/*/judge/
evals/results/*/excerpts.json

# Tutoring eval: practice problems written from the MIT OCW corpora (CC BY-NC-SA); rebuilt locally, see evals/README.md
evals/tutoring/scenarios/practice.jsonl
evals/results/*/judge/
evals/results/*/turns.json

# internal working notes, never committed
.superpowers/
